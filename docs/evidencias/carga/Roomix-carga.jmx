        <stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/reservas/disponibilidad?fechaEntrada=${__timeShift(yyyy-MM-dd,,P${__intSum(400,${__threadNum},)}D,,)}&amp;fechaSalida=${__timeShift(yyyy-MM-dd,,P${__intSum(401,${__threadNum},)}D,,)}</stringProp>
