# Variables de entorno del backend Roomix (copia a tu plataforma: Railway / Render / Neon + host)
# ----------------------------------------------------------------------------------------------

# Base de datos — usa UNA de las dos opciones:
# Opción A (recomendada en Railway/Render/Neon): URL completa tal como la entrega el proveedor
DATABASE_URL=postgresql://usuario:clave@host:5432/roomix?sslmode=require
# Opción B: valores separados (formato JDBC)
# DB_URL=jdbc:postgresql://host:5432/roomix?sslmode=require
# DB_USERNAME=usuario
# DB_PASSWORD=clave

# URL(s) del frontend desplegado, separadas por coma (admite comodines: https://*.vercel.app)
# https://localhost = app Android (APK con Capacitor)
CORS_ALLOWED_ORIGINS=https://roomix-front.onrender.com,https://localhost

# --- Seguridad (OBLIGATORIAS en producción) -----------------------------------------------
# Clave para firmar los JWT: texto aleatorio de 32+ caracteres. Si cambia, se cierran todas las sesiones.
JWT_SECRET=cambia-esto-por-un-texto-aleatorio-de-al-menos-32-caracteres
# Contraseña inicial del administrador (se usa solo cuando la tabla de usuarios está vacía)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=UnaClaveSegura2026
# Usuarios de demostración (uno por rol: recepcion, housekeeping, finanzas, eventos, almacen)
APP_DEMO_USERS=true
DEMO_USERS_PASSWORD=OtraClaveSegura2026
# JWT_EXPIRATION_HOURS=8

# URL pública del frontend: se usa en el enlace del correo de recuperación de contraseña
FRONTEND_URL=https://roomix-front.onrender.com

# --- Correo (opcional): sin SMTP, el enlace de recuperación se registra en el log ---------------
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=cuenta@gmail.com
# SPRING_MAIL_PASSWORD=clave-de-aplicacion
# MAIL_FROM=Roomix <cuenta@gmail.com>

# --- Datos del hotel (encabezado de facturas y comprobantes) -----------------------------------
# HOTEL_NOMBRE=Hotel Roomix
# HOTEL_NIT=900.000.000-0
# HOTEL_DIRECCION=Calle del Arsenal # 10-25
# HOTEL_CIUDAD=Cartagena de Indias, Colombia
# HOTEL_TELEFONO=+57 605 000 0000
# HOTEL_EMAIL=reservas@roomix.test
# HOTEL_PREFIJO_FACTURA=FV
# HOTEL_IVA=19
# HOTEL_EXENTO_IVA_EXTRANJEROS=true    # art. 481 E.T.: extranjeros no residentes con pasaporte

# Carga los datos de demostración la primera vez (solo si no hay habitaciones). Luego puedes quitarla.
APP_SEED_ENABLED=true

# Opcionales
# PORT=8080                       # lo define la plataforma automáticamente
# APP_TIMEZONE=America/Bogota
# DB_POOL_SIZE=5
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=false
# SWAGGER_ENABLED=true
